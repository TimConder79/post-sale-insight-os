# Server/tooling only; never prefix credentials or the owner ID with VITE_.
# Local PostgreSQL example only. Use your own credentials outside local development.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/post_sale_insight_os
# One stable server-owned workspace identity (not a login or browser-controlled identity).
# Generate a UUID once for your local workspace; this example is non-secret.
WORKSPACE_USER_ID=33333333-3333-4333-8333-333333333333
# Default: unavailable. Use openai for real assistance or stub for explicit development preview only.
AI_MODE=unavailable
# API/production server binds to 127.0.0.1 only. Vite's dev proxy targets port 3001.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Real AI is opt-in: set AI_MODE=openai and provide the key in your untracked server environment.
# If the key is absent, openai mode falls back to unavailable (never to a fake suggestion).
OPENAI_API_KEY=
# Server-only model override; default balances structured output support, latency and cost.
OPENAI_MODEL=gpt-4.1-mini
